name: Test and deploy

on:
  # Every push to main: run tests, then publish the site.
  push:
    branches: [main]
  # Weekly data refresh. Mondays at 3:17 UTC (late Sunday night in Richmond),
  # when the public OpenStreetMap servers are least busy.
  schedule:
    - cron: '17 3 * * 1'
  # Lets you run it by hand from the Actions tab.
  workflow_dispatch:

permissions:
  contents: write
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - run: npm ci

      - name: Refresh park data
        if: github.event_name != 'push'
        # If OpenStreetMap is down, keep going and publish the existing data.
        continue-on-error: true
        timeout-minutes: 60
        run: npm run fetch-parks

      - name: Save refreshed data
        if: github.event_name != 'push'
        run: |
          if git diff --quiet src/data/parks.json; then
            echo "Park data unchanged."
            exit 0
          fi
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add src/data/parks.json
          git commit -m "Refresh park data from OpenStreetMap"
          git push

      - name: Run tests
        run: npm test -- --watchAll=false
        env:
          CI: true

      - name: Build
        run: npm run build
        env:
          # Don't fail the deploy over lint warnings.
          CI: false

      - uses: actions/upload-pages-artifact@v3
        with:
          path: build

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4